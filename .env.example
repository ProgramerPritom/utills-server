PORT=5000
GEMINI_API_KEY=your_gemini_api_key_here
N8N_WEBHOOK_URL=https://n8n.glowradius.com/webhook/generate-output
# ============================================================
# GROWKINS E-COMMERCE CONFIGURATIONS (Google Sheets & Drive)
# ============================================================
# 1. Google Spreadsheet ID (from spreadsheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GROWKINS_GOOGLE_SHEET_ID=your_google_sheet_id_here

# 2. Google Drive Folder ID for uploaded product/media images
GROWKINS_GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# 3. Google Service Account Credentials
# (Either use client email + private key OR place 'growkins-credentials.json' in utills-server root directory)
GROWKINS_GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GROWKINS_GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
